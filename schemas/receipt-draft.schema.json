{
  "$ref": "#/definitions/SearchReceiptDraft",
  "definitions": {
    "SearchReceiptDraft": {
      "type": "object",
      "properties": {
        "schemaVersion": { "type": "string", "const": "searchreceipt/v0.1" },
        "id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9][a-zA-Z0-9._:-]*$"
        },
        "createdAt": { "type": "string", "format": "date-time" },
        "subject": {
          "type": "object",
          "properties": {
            "action": { "type": "string", "enum": ["search", "research"] },
            "query": { "type": "string", "minLength": 1, "maxLength": 8000 }
          },
          "required": ["action", "query"],
          "additionalProperties": false
        },
        "provenance": {
          "type": "object",
          "properties": {
            "producer": { "type": "string", "minLength": 1, "maxLength": 200 },
            "method": {
              "type": "string",
              "enum": [
                "agent/search",
                "agent/research",
                "human/research",
                "fixture/demo"
              ]
            },
            "benchmark": { "type": "boolean" },
            "notes": { "type": "string", "maxLength": 2000 }
          },
          "required": ["producer", "method", "benchmark"],
          "additionalProperties": false
        },
        "policy": {
          "type": "object",
          "properties": {
            "requireClaimEvidence": { "type": "boolean", "const": true },
            "requireLocalContent": { "type": "boolean" },
            "allowedHashAlgorithms": {
              "type": "array",
              "minItems": 1,
              "maxItems": 1,
              "items": [{ "type": "string", "const": "sha256" }]
            }
          },
          "required": [
            "requireClaimEvidence",
            "requireLocalContent",
            "allowedHashAlgorithms"
          ],
          "additionalProperties": false
        },
        "evidence": {
          "type": "array",
          "items": {
            "anyOf": [
              {
                "type": "object",
                "properties": {
                  "id": {
                    "$ref": "#/definitions/SearchReceiptDraft/properties/id"
                  },
                  "kind": { "type": "string", "const": "web" },
                  "uri": { "type": "string", "format": "uri" },
                  "title": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 500
                  },
                  "retrievedAt": {
                    "$ref": "#/definitions/SearchReceiptDraft/properties/createdAt"
                  },
                  "contentHash": {
                    "type": "string",
                    "pattern": "^sha256:[a-f0-9]{64}$"
                  },
                  "contentPath": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 512
                  }
                },
                "required": ["id", "kind", "uri", "retrievedAt", "contentHash"],
                "additionalProperties": false
              },
              {
                "type": "object",
                "properties": {
                  "id": {
                    "$ref": "#/definitions/SearchReceiptDraft/properties/id"
                  },
                  "kind": { "type": "string", "const": "file" },
                  "path": {
                    "$ref": "#/definitions/SearchReceiptDraft/properties/evidence/items/anyOf/0/properties/contentPath"
                  },
                  "capturedAt": {
                    "$ref": "#/definitions/SearchReceiptDraft/properties/createdAt"
                  },
                  "contentHash": {
                    "$ref": "#/definitions/SearchReceiptDraft/properties/evidence/items/anyOf/0/properties/contentHash"
                  },
                  "contentPath": {
                    "$ref": "#/definitions/SearchReceiptDraft/properties/evidence/items/anyOf/0/properties/contentPath"
                  }
                },
                "required": ["id", "kind", "path", "capturedAt", "contentHash"],
                "additionalProperties": false
              },
              {
                "type": "object",
                "properties": {
                  "id": {
                    "$ref": "#/definitions/SearchReceiptDraft/properties/id"
                  },
                  "kind": { "type": "string", "const": "solanaTransaction" },
                  "cluster": {
                    "type": "string",
                    "enum": ["mainnet-beta", "devnet", "testnet", "localnet"]
                  },
                  "signature": {
                    "type": "string",
                    "minLength": 64,
                    "maxLength": 88,
                    "pattern": "^[1-9A-HJ-NP-Za-km-z]+$"
                  },
                  "slot": { "type": "integer", "minimum": 0 },
                  "observedAt": {
                    "$ref": "#/definitions/SearchReceiptDraft/properties/createdAt"
                  },
                  "contentHash": {
                    "$ref": "#/definitions/SearchReceiptDraft/properties/evidence/items/anyOf/0/properties/contentHash"
                  },
                  "contentPath": {
                    "$ref": "#/definitions/SearchReceiptDraft/properties/evidence/items/anyOf/0/properties/contentPath"
                  }
                },
                "required": [
                  "id",
                  "kind",
                  "cluster",
                  "signature",
                  "slot",
                  "observedAt",
                  "contentHash"
                ],
                "additionalProperties": false
              },
              {
                "type": "object",
                "properties": {
                  "id": {
                    "$ref": "#/definitions/SearchReceiptDraft/properties/id"
                  },
                  "kind": { "type": "string", "const": "solanaAccount" },
                  "cluster": {
                    "type": "string",
                    "enum": ["mainnet-beta", "devnet", "testnet", "localnet"]
                  },
                  "address": {
                    "type": "string",
                    "minLength": 32,
                    "maxLength": 44,
                    "pattern": "^[1-9A-HJ-NP-Za-km-z]+$"
                  },
                  "ownerProgram": {
                    "type": "string",
                    "minLength": 32,
                    "maxLength": 44,
                    "pattern": "^[1-9A-HJ-NP-Za-km-z]+$"
                  },
                  "slot": { "type": "integer", "minimum": 0 },
                  "observedAt": {
                    "$ref": "#/definitions/SearchReceiptDraft/properties/createdAt"
                  },
                  "contentHash": {
                    "$ref": "#/definitions/SearchReceiptDraft/properties/evidence/items/anyOf/0/properties/contentHash"
                  },
                  "contentPath": {
                    "$ref": "#/definitions/SearchReceiptDraft/properties/evidence/items/anyOf/0/properties/contentPath"
                  }
                },
                "required": [
                  "id",
                  "kind",
                  "cluster",
                  "address",
                  "slot",
                  "observedAt",
                  "contentHash"
                ],
                "additionalProperties": false
              },
              {
                "type": "object",
                "properties": {
                  "id": {
                    "$ref": "#/definitions/SearchReceiptDraft/properties/id"
                  },
                  "kind": { "type": "string", "const": "solanaProgram" },
                  "cluster": {
                    "type": "string",
                    "enum": ["mainnet-beta", "devnet", "testnet", "localnet"]
                  },
                  "programId": {
                    "type": "string",
                    "minLength": 32,
                    "maxLength": 44,
                    "pattern": "^[1-9A-HJ-NP-Za-km-z]+$"
                  },
                  "deploymentSlot": { "type": "integer", "minimum": 0 },
                  "observedAt": {
                    "$ref": "#/definitions/SearchReceiptDraft/properties/createdAt"
                  },
                  "contentHash": {
                    "$ref": "#/definitions/SearchReceiptDraft/properties/evidence/items/anyOf/0/properties/contentHash"
                  },
                  "contentPath": {
                    "$ref": "#/definitions/SearchReceiptDraft/properties/evidence/items/anyOf/0/properties/contentPath"
                  }
                },
                "required": [
                  "id",
                  "kind",
                  "cluster",
                  "programId",
                  "observedAt",
                  "contentHash"
                ],
                "additionalProperties": false
              }
            ]
          },
          "minItems": 1,
          "maxItems": 1000
        },
        "claims": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "id": {
                "$ref": "#/definitions/SearchReceiptDraft/properties/id"
              },
              "statement": {
                "type": "string",
                "minLength": 1,
                "maxLength": 4000
              },
              "evidenceRefs": {
                "type": "array",
                "items": {
                  "$ref": "#/definitions/SearchReceiptDraft/properties/id"
                },
                "minItems": 1,
                "maxItems": 100
              }
            },
            "required": ["id", "statement", "evidenceRefs"],
            "additionalProperties": false
          },
          "maxItems": 1000
        }
      },
      "required": [
        "schemaVersion",
        "id",
        "createdAt",
        "subject",
        "provenance",
        "policy",
        "evidence",
        "claims"
      ],
      "additionalProperties": false
    }
  },
  "$schema": "http://json-schema.org/draft-07/schema#"
}
