{
  "name": "searchreceipt",
  "version": "0.1.0",
  "description": "Local-first deterministic evidence receipts for AI agent research on Solana",
  "type": "module",
  "bin": {
    "searchreceipt": "dist/cli.js"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "schemas",
    "README.md",
    "LICENSE",
    "SECURITY.md",
    "CHANGELOG.md"
  ],
  "engines": {
    "node": ">=20"
  },
  "packageManager": "pnpm@10.34.0",
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "check": "pnpm format:check && pnpm lint && pnpm typecheck && pnpm test && pnpm build",
    "demo": "pnpm build && node dist/cli.js create fixtures/demo/draft.json --output fixtures/demo/receipt.json && node dist/cli.js verify fixtures/demo/receipt.json --root fixtures/demo --json",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lint": "eslint .",
    "pack:check": "npm pack --dry-run --json --ignore-scripts | tsx scripts/verify-pack-manifest.ts",
    "schema:generate": "tsx scripts/generate-schemas.ts",
    "schema:check": "tsx scripts/generate-schemas.ts --check",
    "pretest": "pnpm build",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "typecheck": "tsc --noEmit"
  },
  "keywords": [
    "solana",
    "ai-agents",
    "provenance",
    "evidence",
    "cli"
  ],
  "homepage": "https://github.com/nx107/searchreceipt",
  "repository": {
    "type": "git",
    "url": "https://github.com/nx107/searchreceipt.git"
  },
  "bugs": {
    "url": "https://github.com/nx107/searchreceipt/issues"
  },
  "license": "MIT",
  "dependencies": {
    "zod": "3.25.76"
  },
  "devDependencies": {
    "@eslint/js": "9.32.0",
    "@types/node": "22.17.0",
    "@vitest/coverage-v8": "3.2.6",
    "eslint": "9.32.0",
    "eslint-config-prettier": "10.1.8",
    "prettier": "3.6.2",
    "tsx": "4.20.3",
    "typescript": "5.8.3",
    "typescript-eslint": "8.38.0",
    "vitest": "3.2.6",
    "zod-to-json-schema": "3.24.6"
  }
}
